---
// Buttondown's embeddable-form pattern: posts to their API, then opens a
// confirmation popup. Swap BUTTONDOWN_USERNAME in src/consts.ts once you've
// created an account — see README.md.
import { BUTTONDOWN_USERNAME, SUBSCRIBE_ACTION } from "../consts";

interface Props {
  id?: string;
  heading?: string;
  copy?: string;
}

const {
  id = "subscribe",
  heading = "Get the next issue",
  copy = "One dispatch at a time. No filler.",
} = Astro.props;
---

<div class="signup" id={id}>
  <h4>{heading}</h4>
  <p>{copy}</p>
  <form
    class="signup-form"
    action={SUBSCRIBE_ACTION}
    method="post"
    target="popupwindow"
    onsubmit={`window.open('https://buttondown.com/${BUTTONDOWN_USERNAME}', 'popupwindow')`}
  >
    <input type="email" name="email" placeholder="you@domain.com" required />
    <input type="hidden" value="1" name="embed" />
    <button type="submit">Subscribe</button>
  </form>
</div>
