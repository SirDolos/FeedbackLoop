---
import Base from "../layouts/Base.astro";
import { AUTHORS, SITE_TITLE } from "../consts";
---

<Base title="About">
  <div class="wrap">
    <div class="article-header" style="border-bottom:none;">
      <div class="eyebrow">About</div>
      <h1>{SITE_TITLE}</h1>
    </div>
    <div class="article-body" style="padding-top: 0;">
      <p>
        {SITE_TITLE} is written by college students publishing original
        research and analysis on markets and the broader economy. Each issue
        reflects our own work rather than recycled commentary, and we hold
        ourselves accountable to it.
      </p>

      <hr class="rule" style="margin: 32px 0;" />

      <div class="author-list">
        {
          AUTHORS.map((author) => (
            <div class="author-card">
              {author.photo ? (
                <img
                  class="author-photo"
                  src={author.photo}
                  alt={author.name}
                  width="96"
                  height="96"
                />
              ) : (
                <div class="author-photo-placeholder">
                  {author.name.charAt(0)}
                </div>
              )}
              <div>
                <h3>{author.name}</h3>
                <p class="byline">{author.role}</p>
                {author.bio && <p class="bio">{author.bio}</p>}
              </div>
            </div>
          ))
        }
      </div>

      <hr class="rule" style="margin: 32px 0;" />

      <p>
        Have a tip, correction, or want to get in touch? Add your contact
        details or a link to a contact form here.
      </p>
    </div>
  </div>
</Base>
